+static void test_observer_large_continuous_angle(void)
+{
+    /* Zero torque + zero drag implies constant velocity and zero disturbance.
+     * Generate positions in double, then quantize once at the actual C API.
+     * Do not accumulate the fixture's trajectory in float like the observer. */
+    const float offsets[] = {-1000.0f, 0.0f, 1000.0f};
+    const float periods[] = {0.001f, 0.002f};
+    const float speeds[] = {-0.2f, 0.2f};
+    for (unsigned oi = 0; oi < sizeof(offsets) / sizeof(offsets[0]); ++oi)
+    for (unsigned hi = 0; hi < sizeof(periods) / sizeof(periods[0]); ++hi)
+    for (unsigned vi = 0; vi < sizeof(speeds) / sizeof(speeds[0]); ++vi) {
+        YawConfig cfg = config();
+        cfg.damping_nm_s_rad = cfg.eso_gain = 0.0f;
+        cfg.eso_bandwidth_rad_s = 140.0f;
+        cfg.position_min_rad = -2000.0f; cfg.position_max_rad = 2000.0f;
+        YawController c;
+        YawFeedback f = feedback();
+        YawReference r = reference();
+        YawOutput out;
+        double squared_disturbance = 0.0, velocity_error = 0.0;
+        const float h = periods[hi], speed = speeds[vi];
+        assert(yaw_controller_init(&c, &cfg));
+        for (int k = 0; k <= 5000; ++k) {
+            f.position_rad = (float)((double)offsets[oi] + (double)k * h * speed);
+            f.velocity_rad_s = speed;
+            r.position_rad = f.position_rad; r.velocity_rad_s = speed;
+            assert(yaw_controller_step(&c, &f, &r, h, &out) ==
+                   (k == 0 ? YAW_WARMUP : YAW_OK));
+            assert(out.flags == 0 && out.torque_nm == 0.0f);
+            if (k > 1000) {
+                squared_disturbance += (double)out.disturbance_nm * out.disturbance_nm;
+                velocity_error += (double)c.observer_velocity_rad_s - speed;
+            }
+        }
+        const double rms = sqrt(squared_disturbance / 4000.0);
+        const double bias = velocity_error / 4000.0;
+        printf("ESO precision: offset=%g h=%g speed=%g d_rms=%.9g velocity_bias=%.9g\n",
+               (double)offsets[oi], (double)h, (double)speed, rms, bias);
+        /* Fixture-specific numerical bounds, not a motor performance gate.
+         * Allow float input quantization; reject the old ~0.0115 rad/s bias. */
+        assert(rms < 0.0035 && fabs(bias) < 0.0002);
+    }
+    /* A numerically equivalent rewrite must also preserve tiny corrections. */
+    YawConfig cfg = config();
+    cfg.eso_gain = 0.0f; cfg.eso_bandwidth_rad_s = 1e-6f;
+    YawController c;
+    YawFeedback f = feedback();
+    YawReference r = reference();
+    YawOutput out;
+    assert(yaw_controller_init(&c, &cfg));
+    assert(yaw_controller_step(&c, &f, &r, 0.001f, &out) == YAW_WARMUP);
+    f.position_rad = r.position_rad = 1.0f;
+    assert(yaw_controller_step(&c, &f, &r, 0.001f, &out) == YAW_OK);
+    assert(fabsf(c.observer_position_rad - 3e-9f) < 1e-14f);
+}
